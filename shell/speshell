#!/usr/bin/env bash
set -euo pipefail

# Runs the shell this script sits in, which /usr/bin/speshell links to, or a
# checkout's; SPESHELL_QML_DIR runs another copy.
script_dir="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
readonly app_dir="${SPESHELL_QML_DIR:-$script_dir}"
readonly config_file="${XDG_CONFIG_HOME:-$HOME/.config}/speshell/config.ini"
# The user unit that runs the packaged shell under the session and restarts it if it
# crashes, when the session starts it.
readonly unit=speshell.service
readonly unit_dir=/usr/share/speshell

if [[ ! -r "$app_dir/shell.qml" ]]; then
  printf 'speshell: shell.qml not found in %s\n' "$app_dir" >&2
  exit 1
fi

# The instance on this display, or from a console, the one on any.
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
  display_args=()
else
  display_args=(--any-display)
fi

# Prints the call's output. A frozen instance still accepts IPC connections but never
# answers, so give up after a few seconds; that exits with status 124. An instance
# without the target, as before its config loads, says so and exits 0; that is 3 here.
ipc_try() {
  local output
  output="$(timeout 3 /usr/bin/quickshell ipc "${display_args[@]}" -p "$app_dir" call -- "$@" 2>/dev/null)" || return
  if [[ "$output" == "Target not found." ]]; then
    return 3
  fi
  if [[ -n "$output" ]]; then
    printf '%s\n' "$output"
  fi
}

# Says so when the running instance has stopped on an invalid config.ini.
config_invalid() {
  if [[ "$(ipc_try config status)" != invalid ]]; then
    return 1
  fi
  printf 'speshell: config.ini is invalid, so Speshell is stopped until it is fixed: %s\n' "$config_file" >&2
}

# Whether the unit runs this shell: it is the packaged one, and the unit is running,
# starting, or failed rather than never started.
runs_as_unit() {
  [[ "$app_dir" == "$unit_dir" ]] || return 1
  local state
  state="$(systemctl --user show -P ActiveState "$unit" 2>/dev/null)" || return 1
  [[ -n "$state" && "$state" != inactive ]]
}

# Stops this display's instances, which stopped answering: a moment for each to exit,
# then SIGKILL.
stop_frozen_instances() {
  local pid
  for pid in $(/usr/bin/quickshell list -j -p "$app_dir" 2>/dev/null | sed -n 's/^ *"pid": \([0-9]*\).*/\1/p'); do
    printf 'speshell: instance %s stopped responding; restarting it\n' "$pid" >&2
    kill -TERM "$pid" 2>/dev/null || continue
    for _ in $(seq 1 40); do
      kill -0 "$pid" 2>/dev/null || continue 2
      sleep 0.05
    done
    kill -KILL "$pid" 2>/dev/null || true
  done
}

# Starts Speshell, or starts it over when it froze: through the unit when that runs it,
# which stops a frozen one itself, else as a daemon of its own.
start_instance() {
  if runs_as_unit; then
    systemctl --user reset-failed "$unit" 2>/dev/null || true
    systemctl --user restart "$unit"
    return
  fi
  [[ "${1:-}" != frozen ]] || stop_frozen_instances
  # It saves its own log; its output would end up in the reply.
  /usr/bin/quickshell -p "$app_dir" --no-duplicate --daemonize >/dev/null 2>&1
}

ipc_call() {
  local status=0
  ipc_try "$@" || status=$?
  if (( status == 0 )); then
    return 0
  fi
  if (( status == 124 )); then
    # A busy instance may answer a moment later: ask it something harmless once more
    # before starting it over, rather than send the call twice.
    if ipc_try config status >/dev/null; then
      printf 'speshell: Speshell took too long to answer %s\n' "${1:-unknown}" >&2
      return 1
    fi
    # From a console there is no telling which display's instance froze, nor a display
    # to start one on.
    if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
      printf 'speshell: Speshell stopped responding\n' >&2
      return 1
    fi
    start_instance frozen
  elif config_invalid; then
    return 1
  elif [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    printf 'speshell: Speshell is not running, and there is no display to start it on\n' >&2
    return 1
  else
    start_instance
  fi

  for _ in $(seq 1 30); do
    if ipc_try "$@"; then
      return 0
    fi
    sleep 0.05
  done

  config_invalid || printf 'speshell: failed to contact IPC target %s\n' "${1:-unknown}" >&2
  return 1
}

readonly usage_text='usage: speshell [QUICKSHELL OPTIONS]
       speshell help
       speshell launcher [open | close | toggle]
       speshell lock
       speshell panel [list | open NAME | toggle NAME | close]
       speshell timer [get | start LENGTH [NAME] | add LENGTH [NAME] | pause|resume|toggle|stop [NAME]]
       speshell activity [list | set ID STATE LABEL [DETAIL] [ICON] [TONE] | clear ID | refresh]
       speshell tool [list | NAME [MODE]]
       speshell brightness [get | up | down | set PERCENT | keyboard]
       speshell awake|touchpad|airplane|nightlight [get | on | off | toggle]
       speshell theme [get | list | set ID | shuffle [ID] | rescan | open | close | toggle]
       speshell wallpaper [get | set PATH | open | toggle]
       speshell system [COMMAND...]   (speshell system help)'

# The usage of the command given, and exit 2.
usage() {
  printf '%s\n' "$usage_text" | grep -E "speshell ([a-z]+\|)*$command(\|[a-z]+)*( |\$)" | sed -E 's/^ *(usage: )?/usage: /' >&2
  exit 2
}

# Calls an IPC target of core/Runtime.qml or core/Daemon.qml and prints its reply. The targets check
# what the arguments name; a reply of "error: WHY" fails with WHY.
call() {
  local reply
  reply="$(ipc_call "$@")" || exit 1
  if [[ "$reply" == "error: "* ]]; then
    printf 'speshell: %s\n' "${reply#error: }" >&2
    exit 1
  fi
  if [[ -n "$reply" ]]; then
    printf '%s\n' "$reply"
  fi
}

# Anything but a command runs the shell itself.
case "${1:-}" in
  help|-h|--help) printf '%s\n' "$usage_text"; exit 0 ;;
  launcher|lock|panel|timer|activity|tool|brightness|awake|touchpad|airplane|nightlight|theme|wallpaper|system) ;;
  *) exec /usr/bin/quickshell -p "$app_dir" "$@" ;;
esac

command="$1"
action="${2:-}"
shift
shift || true
nargs=$#

# Fails with the usage unless the action got $1 to ${2:-$1} arguments.
takes() {
  (( nargs >= $1 && nargs <= ${2:-$1} )) || usage
}

case "$command" in
  launcher)
    takes 0
    case "${action:=open}" in
      open|close|toggle) call launcher "$action" >/dev/null ;;
      *) usage ;;
    esac
    ;;
  lock)
    [[ -z "$action" ]] || usage
    call lock lock
    ;;
  panel)
    case "${action:=list}" in
      list|close) takes 0 ;;
      open|toggle) takes 1 ;;
      *) usage ;;
    esac
    call panel "$action" "$@"
    ;;
  timer)
    case "${action:=get}" in
      get) takes 0 ;;
      start|add) (( nargs > 0 )) || usage ;;
      pause|resume|toggle|stop) ;;
      *) usage ;;
    esac
    if [[ "$action" == get ]]; then
      call timer get
    else
      call timer "$action" "$*"
    fi
    ;;
  activity)
    case "${action:=list}" in
      list) takes 0; call activity list ;;
      set) takes 3 6; call activity publish "$1" "$2" "$3" "${4:-}" "${5:-info}" "${6:-neutral}" ;;
      clear) takes 1; call activity clear "$1" ;;
      # Hotkey scripts call this on every state change: never start Speshell for it.
      refresh) takes 0; ipc_try activity refresh >/dev/null || true ;;
      *) usage ;;
    esac
    ;;
  tool)
    case "${action:=list}" in
      list) takes 0; call tool list ;;
      *) takes 0 1; call tool run "$action" "${1:-}" ;;
    esac
    ;;
  brightness)
    case "${action:=get}" in
      get|up|down|keyboard) takes 0; call brightness "$action" ;;
      set) takes 1; [[ "$1" =~ ^[0-9]+$ ]] || usage; call brightness set "$1" ;;
      *) usage ;;
    esac
    ;;
  awake|touchpad|airplane|nightlight)
    takes 0
    case "${action:=get}" in
      get) call "$command" get ;;
      on|off|toggle) call "$command" set "$action" ;;
      *) usage ;;
    esac
    ;;
  theme)
    case "${action:=get}" in
      get|list|rescan|open|close|toggle) takes 0 ;;
      set) takes 1 ;;
      shuffle) takes 0 1; set -- "${1:-}" ;;
      *) usage ;;
    esac
    call theme "$action" "$@"
    ;;
  wallpaper)
    case "${action:=get}" in
      get) takes 0; call wallpaper get ;;
      set) takes 1; call wallpaper set "$(realpath -s -- "$1")" ;;
      open|toggle) takes 0; call wallpaper "$action" ;;
      *) usage ;;
    esac
    ;;
  system) exec "$app_dir/system/speshell-system" ${action:+"$action"} "$@" ;;
esac
