#!/bin/bash
# speshell-greeter-theme USER: copies USER's Speshell theme, its colors and wallpaper,
# to /var/lib/speshell/theme/USER, where the login screen, which can't read the home,
# wears it. speshell-greeter-theme@USER.path runs it as root on each theme change; it
# reads the user's files as the user.
set -euo pipefail
user=${1:?usage: speshell-greeter-theme USER}
home=$(getent passwd "$user" | cut -d: -f6)
cd /
as_user() { setpriv --reuid="$user" --regid="$(id -g "$user")" --init-groups -- "$@"; }

# Like the wallpaper below: a regular file, read no further than 1 MiB and for no longer
# than ten seconds.
theme_file=$home/.local/share/speshell/theme.json
as_user test -f "$theme_file" || { echo "speshell-greeter-theme: no $theme_file" >&2; exit 1; }
state=$(timeout 10 setpriv --reuid="$user" --regid="$(id -g "$user")" --init-groups -- \
    head -c $((1024 * 1024)) -- "$theme_file")
out=/var/lib/speshell/theme/$user
install -d -m 0755 "$out"
tmp=$(mktemp -d "$out/.next.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

wallpaper=$(jq -r '.wallpaper // ""' <<<"$state")
ext=${wallpaper##*.}
ext=${ext,,}
shown=""
# Only a regular file, read no further than the limit and for no longer than a minute,
# so a wallpaper path at a pipe or a device can't keep root writing.
limit=$((64 * 1024 * 1024))
case "$ext" in
    jpg|jpeg|png|webp)
        if as_user test -f "$wallpaper" \
            && timeout 60 setpriv --reuid="$user" --regid="$(id -g "$user")" --init-groups -- \
                head -c $((limit + 1)) -- "$wallpaper" > "$tmp/wallpaper.$ext" \
            && [ "$(stat -c %s -- "$tmp/wallpaper.$ext")" -le "$limit" ]; then
            shown=$out/wallpaper.$ext
        else
            rm -f -- "$tmp/wallpaper.$ext"
            echo "speshell-greeter-theme: wallpaper not a file of at most 64 MiB, left out" >&2
        fi
        ;;
esac
jq --arg wallpaper "$shown" '{ theme: .theme, colors: (.snapshot.colors // null), wallpaper: $wallpaper }' \
    <<<"$state" > "$tmp/theme.json"
chmod 0644 "$tmp"/*

find "$out" -maxdepth 1 -name 'wallpaper.*' ! -name "wallpaper.$ext" -delete
[ -z "$shown" ] || mv -f "$tmp/wallpaper.$ext" "$shown"
mv -f "$tmp/theme.json" "$out/theme.json"
