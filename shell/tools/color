#!/usr/bin/env bash
# Copies the color of a pixel the user clicks, as hex.
set -euo pipefail
# shellcheck source=lib.sh
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/lib.sh"

color="$(hyprpicker -f hex 2>/dev/null || true)"
[[ -n "$color" ]] || exit 0
printf '%s' "$color" | wl-copy
notify "Color copied" "$color"
