#!/usr/bin/env bash
# Usage: dictate [cancel]
# Starts recording the default microphone; the next call stops it, transcribes
# it with whisper.cpp, types the text into the focused window and copies it.
# "cancel" discards the recording, or a transcription in progress.
#
# SPESHELL_DICTATION_MODEL      ggml model file; downloaded on first use when
#                               missing and named like one of whisper.cpp's
# SPESHELL_DICTATION_LANGUAGES  whisper language codes, comma-separated; empty
#                               detects any language
# SPESHELL_DICTATION_VOCABULARY uncommon words whisper should spell this way
set -euo pipefail
# shellcheck source=lib.sh
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/lib.sh"

audio_file="$runtime_dir/dictate.wav"
# The last recording, whisper's output and recent transcripts, to debug misheard words.
debug_dir="$runtime_dir/dictation"
model_file="${SPESHELL_DICTATION_MODEL:-${XDG_DATA_HOME:-$HOME/.local/share}/speshell/whisper/ggml-large-v3-turbo-q5_0.bin}"
model_file="${model_file/#\~/$HOME}"
IFS=', ' read -ra languages <<<"${SPESHELL_DICTATION_LANGUAGES:-}"
# Whisper reads this as preceding text, so it nudges spelling but can't
# override a common sound-alike word.
vocabulary="${SPESHELL_DICTATION_VOCABULARY:-}"

trap refresh_activity EXIT

# Appends to the variable named $1 the characters of $2 it doesn't have yet
add_new_chars() {
  local -n chars=$1
  local i c
  for ((i = 0; i < ${#2}; i++)); do
    c="${2:i:1}"
    [[ "$chars" == *"$c"* ]] || chars+="$c"
  done
}

# wtype gives the Nth distinct character of its input keycode N. Chromium and
# Electron apps read letters and digits by their symbol, but anything else by
# its keycode: a space, comma or "é" on 14 acts as Backspace, and whatever
# lands on 29 (Left Ctrl) is dropped, e.g. every "ç" of a long text. Succeeds
# if the distinct characters $1 (in order) avoid both.
keycodes_safe() {
  ((${#1} <= 28)) && [[ ${#1} -lt 14 || "${1:13:1}" == [A-Za-z0-9] ]]
}

# Types $1 with wtype, one call per run of words whose keycodes are safe.
# Text goes via stdin so a leading "-" isn't parsed as a wtype option.
type_text() {
  local chunk="" chars="" next word
  local -a words
  read -ra words <<<"$1"
  for word in "${words[@]}"; do
    next="$chars"
    add_new_chars next "$word "
    if [[ -n "$chunk" ]] && ! keycodes_safe "$next"; then
      printf '%s' "$chunk" | wtype -
      chunk="" next=""
      add_new_chars next "$word "
    fi
    chunk+="$word " chars="$next"
  done
  [[ -z "$chunk" ]] || printf '%s' "$chunk" | wtype -
}

# Short clips are sometimes detected as a neighbouring language. Prints the
# allowed language in the same family as $1, else the first allowed one.
closest_language() {
  local family candidate
  for family in " pt es gl ca it fr ro la oc " " en de nl af da sv no nn is lb "; do
    [[ "$family" == *" $1 "* ]] || continue
    for candidate in "${languages[@]}"; do
      [[ "$family" == *" $candidate "* ]] && { printf '%s' "$candidate"; return; }
    done
  done
  printf '%s' "${languages[0]}"
}

transcribe() {
  whisper-cli -m "$model_file" -f "$audio_file" -l "$1" -nt --prompt "$vocabulary" 2>>"$debug_dir/whisper.log" || true
}

download_model() {
  local name
  name="$(basename -- "$model_file")"
  if [[ ! "$name" =~ ^ggml-[A-Za-z0-9._-]+\.bin$ ]]; then
    notify "Dictation unavailable" "The speech model $model_file doesn't exist."
    return 1
  fi
  if ! command -v curl >/dev/null 2>&1; then
    notify "Dictation unavailable" "Install curl to download the speech model $name."
    return 1
  fi
  speshell activity set dictation busy Dictation "Downloading the speech model…" loader accent >/dev/null 2>&1 || true
  mkdir -p "$(dirname -- "$model_file")"
  if ! curl -fsSL -o "$model_file.part" "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$name"; then
    rm -f "$model_file.part"
    speshell activity clear dictation >/dev/null 2>&1 || true
    notify "Dictation unavailable" "Couldn't download the speech model $name."
    return 1
  fi
  mv "$model_file.part" "$model_file"
  speshell activity clear dictation >/dev/null 2>&1 || true
}

if [[ "${1:-}" == "cancel" ]]; then
  pkill -f "pw-record.*$audio_file" 2>/dev/null || true
  pkill -f "whisper-cli.*$audio_file" 2>/dev/null || true
  rm -f "$audio_file"
  exit 0
fi

if ! pgrep -f "pw-record.*$audio_file" >/dev/null 2>&1; then
  rm -f "$audio_file"
  setsid -f pw-record --channels=1 --rate=16000 "$audio_file" </dev/null >/dev/null 2>&1
  exit 0
fi

# Already recording: stop, then wait (up to 2s) for pw-record to finish the file.
pkill -SIGINT -f "pw-record.*$audio_file" 2>/dev/null || true
for _ in {1..40}; do
  pgrep -f "pw-record.*$audio_file" >/dev/null 2>&1 || break
  sleep 0.05
done
refresh_activity

if [[ ! -s "$audio_file" ]]; then
  rm -f "$audio_file"
  exit 0
fi
[[ -f "$model_file" ]] || download_model || exit 1

mkdir -p "$debug_dir"
: >"$debug_dir/whisper.log"
language="auto"
((${#languages[@]} == 1)) && language="${languages[0]}"
transcription="$(transcribe "$language")"
detected="$(sed -n 's/.*auto-detected language: \([a-z]*\).*/\1/p' "$debug_dir/whisper.log")"

if ((${#languages[@]} > 1)) && [[ -n "$detected" && " ${languages[*]} " != *" $detected "* ]]; then
  retry="$(closest_language "$detected")"
  transcription="$(transcribe "$retry")"
  detected="$detected->$retry"
fi

# One line: whisper's leading newline would make wtype press Enter.
text="$(printf '%s' "$transcription" | tr '\r\n' ' ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/[[:space:]]\+/ /g')"

mv -f "$audio_file" "$debug_dir/last.wav"
echo "$(date +%T) lang=$language detected=${detected:--} text=$text" >>"$debug_dir/log"
tail -n 50 "$debug_dir/log" >"$debug_dir/log.tmp" && mv -f "$debug_dir/log.tmp" "$debug_dir/log"

if [[ -n "$text" ]]; then
  printf '%s' "$text" | wl-copy 2>/dev/null || true
  type_text "$text" 2>/dev/null || true
fi
