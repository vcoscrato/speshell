def root_exists(path):
    """Whether something is at PATH, as root sees it."""
    return run(["test", "-e", str(path), "-o", "-L", str(path)], root=True, check=False).returncode == 0


class Apply:
    """Carries out a plan step by step, keeping the state as it goes."""

    def __init__(self, plan):
        self.plan, self.state = plan, plan.state
        self.changed = []  # the files whose content changed

    def of(self, kind, user=None):
        return [s.subject for s in self.plan.steps if s.kind == kind and (user is None or s.user == user)]

    def systemctl(self, user, *args):
        if user:
            run(["systemctl", "--user", *args])
        else:
            run(["systemctl", *args], root=True)

    def go(self):
        self.services("disable", "Disabling")
        self.groups("leave", "Leaving", ["gpasswd", "-d", USER])
        if self.of("unlinger"):
            step("No longer starting your services at boot")
            run(["loginctl", "disable-linger", USER], root=True)
        self.packages()
        self.files()
        self.triggers()
        self.groups("join", "Joining", ["gpasswd", "-a", USER])
        self.state["groups"] = list(self.plan.groups)
        if self.of("linger"):
            step("Starting your services at boot")
            run(["loginctl", "enable-linger", USER], root=True)
        self.state["linger"] = bool(self.plan.linger)
        save_state(self.state)
        self.services("enable", "Enabling")
        self.state["services"] = [f"{scope} {unit}" for scope, unit in self.plan.units]
        save_state(self.state)
        self.runs()

    def services(self, kind, verb):
        for user in (False, True):
            units = self.of(kind, user)
            if units:
                step(f"{verb} {', '.join(units)}" + (" for you" if user else ""))
                self.systemctl(user, kind, "--now", "--", *units)

    def groups(self, kind, verb, command):
        for group in self.of(kind):
            step(f"{verb} the {group} group")
            run([*command, group], root=True)
            if kind == "join":
                print(f"{USER} is in {group} from the next login.", flush=True)

    def packages(self):
        names = self.of("demote")
        if names:
            step(f"Keeping {len(names)} as dependencies")
            run(["pacman", "-D", "--asdeps", "--", *names], root=True)
        names = self.of("remove")
        if names:
            step(f"Removing {plural(len(names), 'package')}")
            run(["pacman", "-Rns", "--", *names], root=True)
        names = self.of("install")
        if names:
            step(f"Installing {plural(len(names), 'package')}")
            packages("-S", "--needed", "--", *names)
        names = self.of("explicit")
        if names:
            step(f"Marking {len(names)} as explicitly installed")
            run(["pacman", "-D", "--asexplicit", "--", *names], root=True)
        self.state["packages"] = list(self.plan.wanted)
        save_state(self.state)

    def files(self):
        kinds = ("link", "keep", "copy", "mode", "unlink", "delete", "restore", "reinstate", "forget")
        steps = [s for s in self.plan.steps if s.kind in kinds]
        if steps:
            step("Placing files")
        kept = set()
        for item in steps:
            target, placed = item.subject, self.plan.files.get(item.subject)
            print(f"  {item.text}", flush=True)
            if item.keep and self.keep(target):
                kept.add(target)
            if item.kind == "link":
                link_atomically(placed.source, target)
            elif item.kind == "copy":
                if (
                    run(
                        ["cmp", "-s", "--", str(placed.source), target],
                        root=True,
                        check=False,
                        stderr=subprocess.DEVNULL,
                    ).returncode
                    == 0
                ):
                    # Only its owner or mode differed from the module's.
                    self.own(target, item.mode)
                    continue
                run(
                    ["install", "-D", "-m", item.mode, "-o", "root", "-g", "root", "--", str(placed.source), target],
                    root=True,
                )
            elif item.kind == "mode":
                self.own(target, item.mode)
            elif item.kind == "unlink":
                os.unlink(target)
            elif item.kind == "delete":
                run(["rm", "-f", "--", target], root=True)
            elif item.kind == "restore":
                self.restore(target)
            elif item.kind == "reinstate":
                self.reinstate(target, item.detail)
            # A forgotten file stays as it is, and the state below no longer has it.
            if item.changes:
                self.changed.append(target)
        files = {}
        for target, placed in self.plan.files.items():
            if target.startswith(f"{HOME}/"):
                if linked(target, placed.source):
                    files[target] = {"module": placed.module, "kind": "link"}
                continue
            record = {"module": placed.module, "kind": "copy", "sha": sha(placed.source), "size": None, "mtime": None}
            if os.path.exists(target):
                stat = os.stat(target)
                record.update(size=stat.st_size, mtime=int(stat.st_mtime))
            elif not hidden(target):
                continue
            record["original"] = target in kept or bool(self.state["files"].get(target, {}).get("original"))
            files[target] = record
        self.state["files"] = files
        save_state(self.state)

    def own(self, target, mode):
        run(["chown", "root:root", "--", target], root=True)
        run(["chmod", mode, "--", target], root=True)

    def keep(self, target):
        """Keeps what is at TARGET before a copy first lands there, unless an apply kept it
        already; whether one is kept."""
        if not root_exists(target):
            return False
        original = ORIGINALS / target.lstrip("/")
        if not root_exists(original):
            run(["install", "-d", "-m", "700", "--", str(ORIGINALS)], root=True)
            run(["mkdir", "-p", "--", str(original.parent)], root=True)
            run(["cp", "-a", "--", target, str(original)], root=True)
        return True

    def restore(self, target):
        """Puts back what the first copy to TARGET replaced, as it was, owner and mode."""
        original = ORIGINALS / target.lstrip("/")
        if not root_exists(original):
            print(f"  {original} is gone, so {target} stays as it is", flush=True)
            return
        run(["mkdir", "-p", "--", os.path.dirname(target)], root=True)
        run(["mv", "-f", "--", str(original), target], root=True)

    def reinstate(self, target, owner):
        """Puts back package OWNER's TARGET, from its archive in pacman's cache."""
        with tarfile.open(self.plan.machine.archive(owner)) as archive:
            member = archive.getmember(target.lstrip("/"))
            if member.issym():
                run(["ln", "-sfn", "--", member.linkname, target], root=True)
                return
            if not member.isfile():
                raise Stop(f"{owner}'s {target} is not a file, so it can't be put back")
            handle, temporary = tempfile.mkstemp(prefix="speshell-system.")
            try:
                with os.fdopen(handle, "wb") as file:
                    shutil.copyfileobj(archive.extractfile(member), file)
                user, group = member.uname or str(member.uid), member.gname or str(member.gid)
                mode = f"{member.mode & 0o7777:o}"
                run(["install", "-m", mode, "-o", user, "-g", group, "--", temporary, target], root=True)
            finally:
                os.unlink(temporary)

    def triggers(self):
        """Runs the on lines of the files that changed; a unit file that changed reloads
        systemd first."""
        units = [target for target in self.changed if "/systemd/" in target]
        if any(not target.startswith(f"{HOME}/") for target in units):
            run(["systemctl", "daemon-reload"], root=True)
        if any(target.startswith(f"{HOME}/") for target in units):
            run(["systemctl", "--user", "daemon-reload"])
        for command, user, _ in self.plan.triggered(self.changed):
            step(f"Running {command}")
            run(["bash", "-c", command], root=not user)

    def runs(self):
        """Each run line's command, as you, from its module's files when it has some.
        One that fails stops the apply, and runs again on the next."""
        commands = {command for id in self.plan.on for command in self.plan.config.modules[id].runs}
        ran = [command for command in self.state["ran"] if command in commands]
        for item in [s for s in self.plan.steps if s.kind == "run"]:
            directory = self.plan.config.modules[item.module].dir
            step(f"Running {item.subject}")
            run(["bash", "-c", item.subject], cwd=directory if directory.is_dir() else HOME)
            ran.append(item.subject)
            self.state["ran"] = ran
            save_state(self.state)
        self.state["ran"] = ran
        save_state(self.state)


def run_command(hold, body, last=True):
    """Runs an apply or update's BODY, one at a time. With HOLD, the terminal waits for
    Enter after a failure, and after the end when this is the LAST of the run, while
    Ctrl+C closes it at once."""
    failed = True
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with open(STATE_DIR / "lock", "w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise Stop("another apply or update is running") from None
            body()
        failed = False
    except Stop as stop:
        for line in str(stop).splitlines():
            print(f"speshell system: {line}", file=sys.stderr, flush=True)
    except OSError as error:
        print(f"speshell system: {describe_error(error)}", file=sys.stderr, flush=True)
    except Exception:
        traceback.print_exc()
        sys.stderr.flush()
    if hold and (failed or last):
        if failed:
            print("\nspeshell system: stopped by the error above; the steps after it did not run.")
        input("\nPress Enter to close. ")
    if failed:
        sys.exit(1)


def apply(args):
    yes = hold = after_update = False
    removing = []
    while args:
        flag = args.pop(0)
        if flag == "--yes":
            yes = True
        elif flag == "--hold":
            hold = True
        elif flag == "--after-update":
            # update's own: what comes after an update goes on unasked, and what leaves asks.
            after_update = True
        elif flag == "--remove" and args:
            removing.append(args.pop(0))
        else:
            usage()

    def body():
        plan = Plan(Config().require(), Machine(), load_state(), removing)
        if plan.problems:
            raise Stop("\n".join(describe_problem(problem) for problem in plan.problems))
        print_plan(plan)
        if not plan.steps:
            return
        ask = not yes and (plan.leaves() or not after_update)
        if ask and input("\nApply? [Y/n] ").strip().lower() not in ("", "y", "yes"):
            return
        if plan.needs_root():
            run(["-v"], root=True)
        Apply(plan).go()
        print(f"\n{HOST.capitalize()} is in sync.")

    run_command(hold, body)


def update(args):
    if any(flag not in ("--yes", "--hold") for flag in args):
        usage()

    def body():
        Config().require()
        step("Updating the system")
        packages("-Syu")

    run_command("--hold" in args, body, last=False)
    # Then whatever the modules declare that the update didn't bring, with pacman's new
    # library should the update have brought one. It asks before taking anything away,
    # as apply does, unless --yes.
    program = str(Path(__file__).resolve())
    os.execv(program, [program, "apply", "--after-update", *args])


