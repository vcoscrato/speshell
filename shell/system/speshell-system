#!/usr/bin/env python3
"""Keeps this machine as its modules declare it.

~/.config/speshell/system/ holds a NAME.conf for each module (its packages, services, the
files it places, and the rest) and files/NAME/ with those files. This machine is the module
named after its hostname, and its use lines bring in the others. This runs as you, and the
steps that need root go through sudo; apply and update ask things, so a terminal runs them.
README.md beside it describes the format.
"""

import fcntl
import fnmatch
import grp
import hashlib
import json
import os
import pwd
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import traceback
from dataclasses import dataclass, field
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "speshell" / "system"
STATE_DIR = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local" / "share") / "speshell" / "system"
STATE = STATE_DIR / "state.json"
# What a copy replaced the first time it landed on a root path, to put back when its line
# goes: root's alone, as the file may be a secret, and outside /etc, where a directory such as
# /etc/pam.d or /etc/nftables.d would read a copy kept beside the file as its own.
ORIGINALS = Path("/var/lib/speshell/system/originals")
# Hostnames don't mind case, and neither do host lines.
HOST = os.uname().nodename.lower()
USER = pwd.getpwuid(os.getuid()).pw_name

USAGE = """usage: speshell system [status [--remove PACKAGE]...]
       speshell system apply [--yes] [--hold] [--remove PACKAGE]...
       speshell system update [--yes] [--hold]
       speshell system init
       speshell system add MODULE PACKAGE... | remove PACKAGE...
       speshell system enable MODULE | disable MODULE
       speshell system adopt FILE | restore FILE"""

NAME = re.compile(r"[A-Za-z0-9._-]+")
PACKAGE = re.compile(r"[a-z0-9@._+-]+")
# What follows each word a module's line can start with, and what it should be; a line
# starting with none of them is a package.
LINES = {
    "use": (re.compile(r"([A-Za-z0-9._-]+(?:\s+[A-Za-z0-9._-]+)*)"), "the modules it brings in"),
    "service": (re.compile(r"(\S+)"), "a unit"),
    "user-service": (re.compile(r"(\S+)"), "a unit"),
    "group": (re.compile(r"([a-z_][a-z0-9_-]*)"), "a group"),
    "linger": (re.compile(r""), "nothing"),
    "file": (
        re.compile(r"(~/\S+|/\S+)(?:\s+(?![0-7]{3,4}$)(\S+))?(?:\s+([0-7]{3,4}))?"),
        "a path, then the module's file and a mode when they aren't the default, as in file /etc/thing.conf thing.conf 600",
    ),
    "on": (re.compile(r"([/~][^:]*):\s*(.+)"), "a path, a colon, and a command, as in on /etc/thing/*: reload"),
    "run": (re.compile(r"(.+)"), "a command"),
}
ENABLED = {"enabled", "enabled-runtime", "static", "indirect", "generated", "alias"}


class Stop(Exception):
    """Ends the command with its message."""


def usage():
    print(USAGE, file=sys.stderr)
    sys.exit(2)


def shown(path):
    """A path as the modules write it: under the home as ~/…, anything else as is."""
    path = str(path)
    home = str(HOME) + "/"
    return "~/" + path[len(home) :] if path.startswith(home) else path


def expand(path):
    return str(HOME / path[2:]) if path.startswith("~/") else path


def sha(path):
    with open(path, "rb") as file:
        return hashlib.file_digest(file, "sha256").hexdigest()


def same(a, b):
    """Whether two files have the same content; False when either can't be read."""
    try:
        if os.path.getsize(a) != os.path.getsize(b):
            return False
        with open(a, "rb") as one, open(b, "rb") as other:
            while chunk := one.read(1 << 16):
                if chunk != other.read(len(chunk)):
                    return False
        return True
    except OSError:
        return False


def hidden(target):
    """Whether TARGET is in a directory only root may look in, as NetworkManager's
    connections are."""
    parent = os.path.dirname(target)
    return not os.path.exists(target) and os.path.exists(parent) and not os.access(parent, os.X_OK)


def write_atomically(path, text, like=None):
    """Replaces PATH with TEXT, keeping the mode of LIKE when given. A link is followed, so a
    module kept elsewhere and linked here stays linked."""
    path = Path(os.path.realpath(path))
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(handle, "w") as file:
        file.write(text)
    if like and os.path.exists(like):
        shutil.copymode(like, temporary)
    else:
        os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def link_atomically(source, target):
    """Makes TARGET a link to SOURCE in one step, replacing a file or link there."""
    Path(target).parent.mkdir(parents=True, exist_ok=True)
    temporary = f"{target}.{os.getpid()}.speshell"
    if os.path.lexists(temporary):
        os.unlink(temporary)
    os.symlink(source, temporary)
    try:
        os.replace(temporary, target)
    except OSError:
        os.unlink(temporary)
        raise


def linked(target, source):
    """Whether TARGET is a link to SOURCE."""
    return os.path.islink(target) and os.path.exists(target) and os.path.samefile(target, source)


def links_into_config(target):
    """Whether TARGET is a link into the modules, dangling or not."""
    if not os.path.islink(target):
        return False
    pointed = os.path.normpath(os.path.join(os.path.dirname(target), os.readlink(target)))
    return pointed.startswith(f"{CONFIG}/")


def describe_error(error):
    """An OSError as a line: what failed, and on what."""
    return f"{error.strerror or error}: {shown(error.filename)}" if error.filename else str(error)


def run(command, root=False, check=True, **options):
    """Runs COMMAND, as root through sudo when ROOT."""
    if root:
        command = ["sudo", *command]
    result = subprocess.run(command, **options)
    if check and result.returncode != 0:
        raise Stop(f"{shlex.join(command)} failed")
    return result


def output(command):
    return subprocess.run(command, capture_output=True, text=True).stdout


def helper():
    """pacman, paru, or yay: what installs and updates."""
    return next((name for name in ("paru", "yay") if shutil.which(name)), "pacman")


def packages(*args):
    """Runs pacman, or paru or yay when there is one."""
    tool = helper()
    if tool == "pacman":
        run(["pacman", *args], root=True)
    else:
        run([tool, *args])


def step(text):
    """A heading for the steps after it: bold on a terminal, as pacman's own."""
    if sys.stdout.isatty():
        print(f"\n\033[1m:: {text}\033[0m", flush=True)
    else:
        print(f"\n:: {text}", flush=True)


def plural(count, word):
    return f"{count} {word}{'' if count == 1 else 's'}"


# ── The modules ─────────────────────────────────────────────────────────────


@dataclass
class Placed:
    """A file a module places: at TARGET, from its module's file SOURCE, with MODE when its
    line gives one."""

    target: str
    source: Path
    mode: str
    line: int
    module: str


@dataclass
class Module:
    id: str
    uses: list = field(default_factory=list)  # (module, line)
    packages: list = field(default_factory=list)
    services: list = field(default_factory=list)  # (scope, unit), scope "system" or "user"
    groups: list = field(default_factory=list)
    linger: bool = False
    files: list = field(default_factory=list)  # Placed, a directory's spread out
    triggers: list = field(default_factory=list)  # (glob, command)
    runs: list = field(default_factory=list)

    @property
    def conf(self):
        return CONFIG / f"{self.id}.conf"

    @property
    def dir(self):
        """Where its files are."""
        return CONFIG / "files" / self.id


@dataclass
class Problem:
    file: str  # relative to CONFIG; "" for one about the modules as a whole
    line: int  # 0 when it isn't about a line
    message: str


def is_package(text):
    """A word alone on its line, other than linger, the one line word that takes nothing:
    so packages named like a line word, such as file, can be declared."""
    return bool(PACKAGE.fullmatch(text)) and text != "linger"


def split_comment(raw):
    """RAW's content and comment. As in a shell, # starts the comment at the line's start
    or after a space, outside quotes, so a run line's s#a#b# or "#1" stays whole."""
    quote = None
    for i, char in enumerate(raw):
        if quote:
            quote = None if char == quote else quote
        elif char in "'\"":
            quote = char
        elif char == "#" and (i == 0 or raw[i - 1].isspace()):
            return raw[:i].strip(), raw[i + 1 :].strip().replace("\t", " ")
    return raw.strip(), ""


class Config:
    """Every module, and the ones this machine uses."""

    def __init__(self):
        self.modules = {}
        self.problems = []
        for path in sorted(CONFIG.glob("*.conf")):
            if NAME.fullmatch(path.stem):
                self.modules[path.stem] = self.read_module(path.stem)
        for module in self.modules.values():
            for name, number in module.uses:
                if name not in self.modules:
                    self.problem(f"{module.id}.conf", number, f"there is no {name}.conf")
        # Hostnames don't mind case, and neither does the module named after one.
        self.machine = next((id for id in self.modules if id.lower() == HOST), "")
        self.on, self.via = [], {}
        if self.machine:
            self.bring(self.machine, [])

    def bring(self, id, chain):
        """Puts ID in self.on after the modules it uses, through theirs: the order this
        machine applies them in. self.via names the module each came with."""
        if id in self.on:
            return
        if id in chain:
            self.problem(
                f"{id}.conf", 0, f"{id} brings itself in, through {' and '.join(chain[chain.index(id) + 1 :])}"
            )
            return
        for name, _ in self.modules[id].uses:
            if name in self.modules:
                self.via.setdefault(name, id)
                self.bring(name, [*chain, id])
        self.on.append(id)

    def problem(self, file, line, message):
        self.problems.append(Problem(file, line, message))

    def read_module(self, id):
        module = Module(id)
        file = f"{id}.conf"
        for number, raw in enumerate(module.conf.read_text().splitlines(), 1):
            text, _ = split_comment(raw)
            if not text:
                continue
            word, rest = [*text.split(None, 1), ""][:2]
            if word not in LINES or (not rest and is_package(text)):
                if is_package(text):
                    module.packages.append(text)
                else:
                    self.problem(file, number, f"'{text}' is not a package name")
                continue
            pattern, wanted = LINES[word]
            match = pattern.fullmatch(rest)
            if not match:
                self.problem(file, number, f"{word} takes {wanted}")
            elif word == "use":
                module.uses += [(name, number) for name in match[1].split()]
            elif word == "run":
                module.runs.append(match[1])
            elif word in ("service", "user-service"):
                module.services.append(("user" if word == "user-service" else "system", match[1].replace("%u", USER)))
            elif word == "group":
                module.groups.append(match[1])
            elif word == "linger":
                module.linger = True
            elif word == "file":
                self.read_file(module, number, *match.groups())
            elif word == "on":
                module.triggers.append((match[1].strip(), match[2]))
        return module

    def read_file(self, module, number, target, name, mode):
        """A file line: TARGET, from the module's file NAME, which is TARGET's name without
        a leading dot unless given; a directory places each file in it."""
        file = f"{module.id}.conf"
        target = target.rstrip("/")
        name = name or os.path.basename(target).removeprefix(".")
        source = module.dir / name
        if target in ("", "~") or os.path.normpath(expand(target)) != expand(target):
            return self.problem(file, number, f"{target or '/'} is not a file to place")
        if target.startswith(f"{HOME}/"):
            return self.problem(file, number, f"write {target} as {shown(target)}, so it is linked as yours")
        if name.startswith("/") or ".." in Path(name).parts:
            return self.problem(file, number, f"{name} is not a file of the module")
        if not source.exists():
            return self.problem(file, number, f"files/{module.id} has no {name}")
        if mode and target.startswith("~/"):
            return self.problem(file, number, "a file in your home is linked, so it keeps its module file's mode")
        for each in spread(source):
            placed = expand(target) + ("/" + str(each.relative_to(source)) if each != source else "")
            if any(placed == other.target for other in module.files):
                return self.problem(file, number, f"{shown(placed)} is already placed")
            module.files.append(Placed(placed, each, mode or "", number, module.id))

    def require(self):
        """Stops unless the modules read cleanly and one is this machine."""
        if self.problems:
            raise Stop("\n".join(describe_problem(problem) for problem in self.problems))
        self.machine_module()
        return self

    def machine_module(self):
        """This machine's module; stops when there is none."""
        if not self.machine:
            raise Stop(f"there is no {shown(CONFIG / HOST)}.conf for this machine; speshell system init starts one")
        return self.modules[self.machine]


def spread(source):
    """SOURCE, or each file under it when it is a directory, through the directories it links
    to, though once each, so a link back up doesn't go round."""
    if not source.is_dir():
        return [source]
    files, seen = [], set()
    for directory, directories, entries in os.walk(source, followlinks=True):
        real = os.path.realpath(directory)
        if real in seen:
            directories.clear()
            continue
        seen.add(real)
        files += [Path(directory) / entry for entry in entries]
    return sorted(files)


def describe_problem(problem):
    where = f"{problem.file}:{problem.line}: " if problem.line else f"{problem.file}: " if problem.file else ""
    return where + problem.message


# ── The machine ─────────────────────────────────────────────────────────────


class Machine:
    """What pacman has: every package installed, which explicitly, and the files they own."""

    def __init__(self):
        try:
            import pyalpm
        except ImportError:
            raise Stop("pyalpm is missing; install it with pacman -S pyalpm") from None
        handle = pyalpm.Handle("/", "/var/lib/pacman")
        self.installed = {package.name: package for package in handle.get_localdb().pkgcache}
        self.explicit = {
            name for name, package in self.installed.items() if package.reason == pyalpm.PKG_REASON_EXPLICIT
        }
        self.owners = None

    def owner(self, path):
        """The package that owns the file at PATH, or ""."""
        if self.owners is None:
            self.owners = {
                "/" + name: package.name for package in self.installed.values() for name, _, _ in package.files
            }
        return self.owners.get(path, "")

    def archive(self, name):
        """The installed version of package NAME in pacman's cache, or None."""
        package = self.installed[name]
        try:
            conf = Path("/etc/pacman.conf").read_text()
        except OSError:
            conf = ""
        directories = re.findall(r"^\s*CacheDir\s*=\s*(.+?)\s*$", conf, re.M) or ["/var/cache/pacman/pkg"]
        for directory in directories:
            for archive in Path(directory).glob(f"{name}-{package.version}-{package.arch}.pkg.tar*"):
                if archive.suffix != ".sig":
                    return archive
        return None


def unit_states(scope, units):
    """systemctl's word for each unit, by unit."""
    if not units:
        return {}
    words = output(["systemctl", *(["--user"] if scope == "user" else []), "is-enabled", "--", *units]).split()
    return dict(zip(units, words, strict=False))


def members(group):
    try:
        return grp.getgrnam(group).gr_mem
    except KeyError:
        return []


LINGER = Path("/var/lib/systemd/linger") / USER


def load_state():
    """What the last apply left: the packages, services, and groups it kept, whether it
    started your services at boot, the files it placed (a copy with its sum, size, and time,
    so a file only root can read is known unchanged, and whether it kept what the copy
    replaced, which a record from before originals were kept doesn't say), and the run
    lines it ran."""
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}
    for key, empty in (
        ("packages", []),
        ("services", []),
        ("groups", []),
        ("linger", False),
        ("files", {}),
        ("ran", []),
    ):
        state.setdefault(key, empty)
    return state


def save_state(state):
    write_atomically(STATE, json.dumps(state, indent=1, sort_keys=True) + "\n")


# ── The plan ────────────────────────────────────────────────────────────────

# Each kind of step, in the order apply takes them, and how a step of it reads. What
# leaves comes before what comes, so a package that replaces one leaving (pipewire-jack for
# jack2, say) doesn't conflict with it, and a service stops before its package goes.
KINDS = {
    "disable": lambda s: f"Disable {s.subject}" + (" for you" if s.user else ""),
    "leave": lambda s: f"Leave the {s.subject} group",
    "unlinger": lambda s: "Stop starting your services at boot",
    "demote": lambda s: f"Keep {s.subject} as a dependency of {s.detail}",
    "remove": lambda s: f"Remove {s.subject}",
    "install": lambda s: f"Install {s.subject}",
    "explicit": lambda s: f"Mark {s.subject} as explicitly installed",
    "link": lambda s: f"Link {shown(s.subject)}",
    "keep": lambda s: f"Keep the original of {s.subject}",
    "copy": lambda s: f"Copy {s.subject}" + (", keeping the original" if s.keep else ""),
    "mode": lambda s: f"Set {s.subject} to mode {s.mode}, owned by root" + (", keeping the original" if s.keep else ""),
    "unlink": lambda s: f"Unlink {shown(s.subject)}",
    "delete": lambda s: f"Delete {s.subject}",
    "restore": lambda s: f"Put back the original of {s.subject}",
    "reinstate": lambda s: f"Put back the {s.detail} package's {s.subject}",
    "forget": lambda s: (
        f"Leave {s.subject} as it is: "
        + (f"{s.detail} owns it, and its package isn't cached" if s.detail else "what it replaced wasn't kept")
    ),
    "trigger": lambda s: f"Run {s.subject}",
    "join": lambda s: f"Join the {s.subject} group",
    "linger": lambda s: "Start your services at boot",
    "enable": lambda s: f"Enable {s.subject}" + (" for you" if s.user else ""),
    "run": lambda s: f"Run {s.subject}",
}
ORDER = list(KINDS)
# The steps that take away what an earlier apply brought, which apply asks about even
# after an update.
LEAVING = {"disable", "leave", "unlinger", "demote", "remove", "unlink", "delete", "restore", "reinstate"}


@dataclass
class Step:
    kind: str
    subject: str
    module: str = ""
    user: bool = False  # enable, disable, trigger: yours rather than the system's
    mode: str = ""  # copy, mode: the mode the file gets
    keep: bool = False  # copy, mode, keep: what is there is kept first, to put back when its line goes
    changes: bool = False  # the file's content changes, so the on lines hear it
    detail: str = ""  # demote: the packages that need it; reinstate, forget: the package owning the file

    @property
    def text(self):
        return KINDS[self.kind](self)


class Plan:
    """What apply would do, what needs your decision (packages no module declares, home
    files that differ from their module's), and how each declared thing stands."""

    def __init__(self, config, machine, state, removing=()):
        self.config, self.machine, self.state = config, machine, state
        self.problems = list(config.problems)
        self.on = config.on
        self.steps = []
        self.drift = []  # (module, target, "changed" or "blocked": something else in the way)
        self.undeclared = []
        self.collect()
        self.plan_services_leaving()
        self.plan_groups()
        self.plan_packages(removing)
        self.plan_files()
        self.plan_triggers()
        self.plan_services()
        self.plan_runs()
        self.steps.sort(key=lambda step: ORDER.index(step.kind))

    def add(self, kind, subject, module="", **fields):
        self.steps.append(Step(kind, subject, module, **fields))

    def collect(self):
        self.wanted, self.units, self.groups, self.files = {}, {}, {}, {}
        self.linger, self.triggers = None, []
        for id in self.on:
            module = self.config.modules[id]
            for name in module.packages:
                self.wanted.setdefault(name, id)
            for unit in module.services:
                self.units.setdefault(unit, id)
            for group in module.groups:
                self.groups.setdefault(group, id)
            if module.linger and not self.linger:
                self.linger = id
            self.triggers += [(glob, command, id) for glob, command in module.triggers]
            for placed in module.files:
                if placed.target in self.files:
                    other = self.files[placed.target].module
                    self.problems.append(
                        Problem(f"{id}.conf", placed.line, f"{shown(placed.target)} is placed by {other} too")
                    )
                    continue
                self.files[placed.target] = placed

    def plan_services_leaving(self):
        left = [tuple(entry.split(" ", 1)) for entry in self.state["services"]]
        for scope in ("system", "user"):
            units = [unit for s, unit in left if s == scope and (s, unit) not in self.units]
            for unit, word in unit_states(scope, units).items():
                if word in ("enabled", "enabled-runtime"):
                    self.add("disable", unit, user=scope == "user")

    def plan_groups(self):
        for group, id in self.groups.items():
            if USER not in members(group):
                self.add("join", group, id)
        for group in self.state["groups"]:
            if group not in self.groups and USER in members(group):
                self.add("leave", group)
        if self.linger and not LINGER.exists():
            self.add("linger", USER, self.linger)
        elif not self.linger and self.state["linger"] and LINGER.exists():
            self.add("unlinger", USER)

    def plan_packages(self, removing):
        installed, explicit = self.machine.installed, self.machine.explicit
        for name in removing:
            if name in self.wanted:
                problem = f"{self.wanted[name]} declares {name}; speshell system remove {name} takes it out first"
            elif name not in installed:
                problem = f"{name} is not installed"
            elif name not in explicit:
                problem = f"{name} is installed as a dependency, so it goes with what needs it"
            else:
                continue
            self.problems.append(Problem("", 0, f"--remove {name}: {problem}"))
        declared = set(self.state["packages"])
        for name in sorted(explicit - self.wanted.keys()):
            if name in declared or name in removing:
                # A package another one needs stays as its dependency; the rest go, with
                # what only they needed.
                needed = installed[name].compute_requiredby()
                if needed:
                    self.add("demote", name, detail=", ".join(needed))
                else:
                    self.add("remove", name)
            else:
                self.undeclared.append(name)
        for name, id in self.wanted.items():
            if name not in installed:
                self.add("install", name, id)
            elif name not in explicit:
                self.add("explicit", name, id)

    def plan_files(self):
        for target, placed in self.files.items():
            if target.startswith(f"{HOME}/"):
                self.plan_home(placed)
            else:
                self.plan_root(placed)
        # What the last apply placed and no module has now.
        for target, record in sorted(self.state["files"].items()):
            if target in self.files:
                continue
            if record["kind"] == "link":
                if links_into_config(target):
                    self.add("unlink", target, record["module"], changes=True)
            else:
                self.plan_leaving_copy(target, record)

    def plan_leaving_copy(self, target, record):
        """A copy whose line went: what it replaced comes back, and a file that wasn't there
        goes, though never one a package owns. A record from before originals were kept
        can't tell which it was, so its file stays."""
        if record.get("original"):
            return self.add("restore", target, record["module"], changes=True)
        owner = self.machine.owner(target)
        if owner and self.machine.archive(owner):
            self.add("reinstate", target, record["module"], changes=True, detail=owner)
        elif owner or "original" not in record:
            self.add("forget", target, record["module"], detail=owner)
        elif os.path.lexists(target) or hidden(target):
            self.add("delete", target, record["module"], changes=True)

    def plan_home(self, placed):
        source, target = placed.source, placed.target
        if linked(target, source):
            return
        # A link of yours, into a dotfiles repository say, stays: only a dangling one, or
        # one into the modules, is replaced.
        if not os.path.lexists(target) or links_into_config(target) or not os.path.exists(target):
            self.add("link", target, placed.module, changes=not same(source, target))
        elif os.path.isfile(target) and not os.path.islink(target) and same(source, target):
            self.add("link", target, placed.module)
        else:
            changed = os.path.isfile(target) and not os.path.islink(target)
            self.drift.append((placed.module, target, "changed" if changed else "blocked"))

    def recorded_unchanged(self, source, target):
        """A root file only root can read is unchanged when its module's file and its size
        and time are as the last apply left them; one only root can see, when its module's
        file is."""
        record = self.state["files"].get(target)
        if not record or record["kind"] != "copy" or record["sha"] != sha(source):
            return False
        if hidden(target):
            return True
        stat = os.stat(target)
        return [stat.st_size, int(stat.st_mtime)] == [record["size"], record["mtime"]]

    def plan_root(self, placed):
        source, target, id = placed.source, placed.target, placed.module
        # Unless its file line gives one: 755 for a program, 440 in sudoers.d, 644 otherwise.
        mode = placed.mode or (
            "755" if os.access(source, os.X_OK) else "440" if target.startswith("/etc/sudoers.d/") else "644"
        )
        concealed = hidden(target)
        # What is there before a copy first lands is kept, to put back when its line goes.
        keep = target not in self.state["files"] and (os.path.lexists(target) or concealed)
        if concealed:
            changed = not self.recorded_unchanged(source, target)
        elif not os.path.exists(target):
            changed = True
        elif os.access(target, os.R_OK):
            changed = not same(source, target)
        else:
            changed = not self.recorded_unchanged(source, target)
        if changed:
            # A sudoers file that doesn't parse would lock sudo out, so it never goes in.
            if target.startswith("/etc/sudoers.d/") and subprocess.run(["visudo", "-cqf", str(source)]).returncode:
                self.problems.append(
                    Problem(
                        f"{id}.conf",
                        placed.line,
                        f"visudo rejects {source.relative_to(CONFIG)}, so it stays out of /etc/sudoers.d",
                    )
                )
                return
            self.add("copy", target, id, mode=mode, keep=keep, changes=True)
            return
        if concealed:
            return
        stat = os.stat(target)
        if stat.st_mode & 0o7777 != int(mode, 8) or (stat.st_uid, stat.st_gid) != (0, 0):
            self.add("mode", target, id, mode=mode, keep=keep)
        elif keep:
            self.add("keep", target, id, keep=True)

    def triggered(self, targets):
        """The commands of the on lines a change to TARGETS fires, once each, as
        (command, whether it runs as you, module)."""
        fired = {}
        for target in targets:
            path = shown(target)
            for glob, command, id in self.triggers:
                if command not in fired and fnmatch.fnmatchcase(path, glob):
                    fired[command] = (not glob.startswith("/"), id)
        return [(command, user, id) for command, (user, id) in fired.items()]

    def plan_triggers(self):
        for command, user, id in self.triggered([step.subject for step in self.steps if step.changes]):
            self.add("trigger", command, id, user=user)

    def plan_services(self):
        for scope in ("system", "user"):
            units = [unit for s, unit in self.units if s == scope]
            for unit, word in unit_states(scope, units).items():
                if word not in ENABLED:
                    self.add("enable", unit, self.units[(scope, unit)], user=scope == "user")

    def plan_runs(self):
        """The run lines this machine hasn't run, or whose command changed since."""
        for id in self.on:
            for command in self.config.modules[id].runs:
                if command not in self.state["ran"] and not any(
                    s.kind == "run" and s.subject == command for s in self.steps
                ):
                    self.add("run", command, id)

    def needs_root(self):
        return any(step.kind not in ("link", "unlink", "forget", "run") and not step.user for step in self.steps)

    def leaves(self):
        """Whether it takes away anything an earlier apply brought."""
        return any(step.kind in LEAVING for step in self.steps)


