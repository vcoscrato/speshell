def print_plan(plan):
    if plan.problems:
        print("Apply stops on these")
        for problem in plan.problems:
            print(f"  {describe_problem(problem)}")
        print()
    if plan.undeclared or plan.drift:
        print("Needs your decision")
        if plan.undeclared:
            print("  Installed, but no module declares them:")
            line = "   "
            for name in plan.undeclared:
                if len(line) + len(name) > 76:
                    print(line)
                    line = "   "
                line += " " + name
            print(line)
        for id, target, reason in plan.drift:
            if reason == "changed":
                print(f"  {shown(target)} differs from {id}'s; adopt or restore it")
            else:
                print(f"  {shown(target)} is in the way of {id}'s file")
        print()
    if not plan.steps:
        if not plan.problems:
            print(f"{HOST.capitalize()} is in sync.")
        return
    print("On apply")
    for item in plan.steps:
        print(f"  {item.text}")


def status(args):
    removing = []
    while args:
        if args.pop(0) == "--remove" and args:
            removing.append(args.pop(0))
        else:
            usage()
    print_plan(Plan(Config().require(), Machine(), load_state(), removing))


