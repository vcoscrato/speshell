def edit_lines(path, change):
    """Rewrites the file at PATH as CHANGE makes its lines, keeping its mode."""
    lines = path.read_text().splitlines() if path.exists() else []
    write_atomically(path, "".join(line + "\n" for line in change(lines)), like=path)


def known(config, id):
    if id not in config.modules:
        raise Stop(f"there is no module {id}")
    return config.modules[id]


def valid(name):
    if not is_package(name):
        raise Stop(f"'{name}' is not a package name")
    return name


def add(args):
    if len(args) < 2:
        usage()
    module = known(Config(), args[0])
    names = [valid(name) for name in args[1:]]
    for name in names:
        if name in module.packages:
            raise Stop(f"{module.id} already has {name}")

    # After its last package, or first in a module without one.
    def change(lines):
        last = max((i for i, line in enumerate(lines) if is_package(split_comment(line)[0])), default=-1)
        return lines[: last + 1] + names + lines[last + 1 :]

    edit_lines(module.conf, change)


def remove(args):
    if not args:
        usage()
    config = Config()
    names = {valid(name) for name in args}
    declared = {name for module in config.modules.values() for name in module.packages}
    missing = sorted(names - declared)
    if missing:
        raise Stop(f"no module declares {', '.join(missing)}")
    for module in config.modules.values():
        if names.intersection(module.packages):
            edit_lines(module.conf, lambda lines: [line for line in lines if split_comment(line)[0] not in names])


def switch(turn, args):
    """Turns a module on or off for this machine, on the use lines of its module."""
    if len(args) != 1:
        usage()
    config = Config()
    id = known(config, args[0]).id
    machine = config.machine_module()
    if id == config.machine:
        raise Stop(f"{id} is this machine")
    if turn == "off" and id in config.on:
        others = [
            other for other in config.on if other != config.machine and id in (n for n, _ in config.modules[other].uses)
        ]
        if others:
            raise Stop(f"{id} comes with {', '.join(others)}; turn that off instead")
    if (turn == "on") == (id in config.on):
        return

    def change(lines):
        edited = []
        for line in lines:
            text, comment = split_comment(line)
            word, rest = [*text.split(None, 1), ""][:2]
            if word == "use":
                names = [name for name in rest.split() if name != id]
                if names:
                    edited.append(f"use {' '.join(names)}" + (f"  # {comment}" if comment else ""))
                continue
            edited.append(line)
        if turn == "on":
            last = max((i for i, line in enumerate(edited) if split_comment(line)[0].startswith("use ")), default=-1)
            if last >= 0:
                edited[last] = re.sub(r"^(use [^#]*?)(\s*(#.*)?)$", rf"\1 {id}\2", edited[last])
            else:
                edited[:0] = [f"use {id}", *([""] if edited and edited[0].strip() else [])]
        return edited

    edit_lines(machine.conf, change)


def home_source(file):
    """The module file a home FILE links to, for adopt and restore."""
    config = Config().require()
    target = os.path.abspath(expand(file))
    for id in config.on:
        for placed in config.modules[id].files:
            if placed.target == target and target.startswith(f"{HOME}/"):
                if os.path.islink(target) or not os.path.isfile(target):
                    raise Stop(f"{shown(target)} is not a file of its own; there is nothing to adopt or restore")
                return target, placed.source
    raise Stop(f"no module of {HOST} links {shown(target)}")


def adopt(args):
    """Takes a home file's changes into its module, then links it again."""
    if len(args) != 1:
        usage()
    target, source = home_source(args[0])
    shutil.copyfile(target, source)
    link_atomically(source, target)


def restore(args):
    """Puts a home file's link back, keeping the file it replaces under the state directory:
    a copy first, then the link in its place in one step, so the file is never missing."""
    if len(args) != 1:
        usage()
    target, source = home_source(args[0])
    kept = STATE_DIR / "replaced" / time.strftime("%Y%m%d-%H%M%S") / os.path.relpath(target, HOME)
    kept.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(target, kept)
    link_atomically(source, target)
    print(f"Kept the replaced file as {shown(kept)}")


def init(args):
    """Starts this machine's module with every package it has explicitly installed."""
    if args:
        usage()
    config = Config()
    if config.machine:
        raise Stop(f"{shown(config.modules[config.machine].conf)} already exists")
    names = sorted(Machine().explicit)
    conf = CONFIG / f"{HOST}.conf"
    write_atomically(conf, "".join(name + "\n" for name in names))
    print(f"Wrote {shown(conf)} with {len(names)} packages.")


def main(argv):
    command, args = (argv[0], argv[1:]) if argv else ("status", [])
    commands = {
        "status": lambda: status(args),
        "apply": lambda: apply(args),
        "update": lambda: update(args),
        "add": lambda: add(args),
        "remove": lambda: remove(args),
        "enable": lambda: switch("on", args),
        "disable": lambda: switch("off", args),
        "adopt": lambda: adopt(args),
        "restore": lambda: restore(args),
        "init": lambda: init(args),
    }
    if command in ("-h", "--help", "help"):
        print(USAGE)
    elif command in commands:
        commands[command]()
    else:
        usage()


if __name__ == "__main__":
    sys.stdout.reconfigure(line_buffering=True)
    try:
        main(sys.argv[1:])
    except Stop as stop:
        for line in str(stop).splitlines():
            print(f"speshell system: {line}", file=sys.stderr)
        sys.exit(1)
    except OSError as error:
        print(f"speshell system: {describe_error(error)}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
