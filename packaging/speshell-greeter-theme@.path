# Watches %i's theme.json in their home, which speshell-greeter-theme's generator adds
# as PathChanged= once this is enabled.
[Unit]
Description=Show %i's Speshell theme on the login screen

[Path]
Unit=speshell-greeter-theme@%i.service

[Install]
WantedBy=multi-user.target
Also=speshell-greeter-theme@%i.service
