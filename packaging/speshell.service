# Speshell under the graphical session, started again if it crashes: the lock, the
# polkit agent, and notifications live in it. The session starts it after importing its
# environment (see the README); `speshell` and Relaunch restart it through systemd.
[Unit]
Description=Speshell desktop shell
Documentation=file:///usr/share/doc/speshell/README.md
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
# Without the session's environment it would draw nowhere, and logind's lock and unlock
# wouldn't reach it: fail, so the session can start Speshell itself instead.
AssertEnvironment=WAYLAND_DISPLAY
AssertEnvironment=XDG_SESSION_ID

[Service]
Type=exec
ExecStart=/usr/bin/quickshell --no-duplicate --path /usr/share/speshell
Restart=on-failure
RestartSec=1
# Apps opened from the launcher run in this unit's group: stopping or restarting
# Speshell leaves them be.
KillMode=process
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
